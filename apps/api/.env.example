# Paradis Immo API — required env vars
DATABASE_URL=postgresql://postgres:postpass@localhost:5432/paradis_immo

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Web app origin (magic link emails)
WEB_APP_URL=http://localhost:3000

# Platform admin seed (email/password login — not OTP)
ADMIN_SEED_EMAIL=admin@paradisimmo.cg
ADMIN_SEED_PASSWORD=Admin123!

# Google Sign-In for web — same OAuth client ID as web AUTH_GOOGLE_ID
GOOGLE_CLIENT_ID=

# CORS — comma-separated origins (defaults to localhost web/Expo if empty)
ALLOWED_ORIGINS=https://app.paradisimmo.cg

# R2 media (optional in dev — API throws if presign is called without it)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paradis-immo
R2_PUBLIC_URL=

# Infobip WhatsApp / SMS (optional in dev — OTP is logged to console)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_WHATSAPP_SENDER=
INFOBIP_SMS_SENDER=

# Mobile Money
MOBILE_MONEY_PROVIDER=AIRTEL
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_WEBHOOK_SECRET=

# FCM push — Firebase service-account JSON as a single-line string (preferred)
# File path also works (e.g. ./secrets/firebase-service-account.json)
FCM_CREDENTIALS=
